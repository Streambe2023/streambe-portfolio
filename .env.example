# Base de datos Postgres (recomendado: Neon, Supabase o Railway - todos tienen plan gratis)
DATABASE_URL="postgresql://usuario:password@host/basededatos?sslmode=require"

# Clave secreta para firmar las sesiones del panel admin.
# Generarla una vez y no compartirla. Ejemplo para generar una en tu compu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="reemplazar-por-una-cadena-larga-y-aleatoria"

# Credenciales del primer usuario admin (solo se usan al correr "npm run prisma:seed")
ADMIN_EMAIL="admin@streambe.com"
ADMIN_PASSWORD="elegir-una-contraseña-segura"
